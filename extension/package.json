{
  "name": "chess-video-position-explorer",
  "version": "0.0.0",
  "private": true,
  "description": "Chrome extension for exploring chess positions captured from videos.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "icons": "node scripts/icons.ts",
    "figures": "node scripts/figures.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "onnxruntime-web": "^1.31.1",
    "preact": "^11.1.1",
    "stockfish": "^19.0.1"
  }
}
